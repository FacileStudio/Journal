# Compose-level template. Every value below is substituted into docker-compose.yml;
# the API's own variables live in apps/api/.env.example.

# Required — internal PostgreSQL credentials
POSTGRES_USER=journal
POSTGRES_PASSWORD=journal-internal-db
# POSTGRES_DB=journal

# Optional — deployment name: development, staging, production
# APP_ENV=production

# Optional — debug, info, warn, error
# LOG_LEVEL=info

# Optional — legacy shared bearer token for POST /api/ingest. Empty disables it;
# per-app API keys created from the dashboard's Keys page are the primary path.
# The collector sidecar ships many apps, so it needs this one.
# INGEST_TOKEN=

# Optional — days to keep ingested log entries before pruning; 0 keeps forever
# RETENTION_DAYS=90

# Optional — allow self-service dashboard registration. First account created becomes
# admin. Set to false to lock sign-ups once your accounts exist (the first account can
# always be created, so you can never lock yourself out).
# ALLOW_REGISTRATION=true

# Optional — single sign-on through the suite's Authentik. Setting OIDC_ISSUER
# turns the other four into hard requirements and the API refuses to start
# without them; leaving it empty keeps email/password auth and registers no OIDC
# endpoint at all. The redirect URL must match the one registered on the
# provider, down to the trailing path.
# OIDC_ISSUER=https://sso.facile.studio/application/o/journal/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://journal.facile.studio/api/auth/oidc/callback
# OIDC_SUCCESS_URL=https://journal.facile.studio

# Optional — retire local passwords. The register and login routes are not
# registered rather than rejected, so there is no endpoint left to probe. It
# requires OIDC_ISSUER: without one there would be no way left to sign in, and
# the API refuses to start rather than lock you out.
# SSO_ONLY=false

# Optional — the scope carrying a flat `roles` claim. Empty disables role
# handling entirely, which is where every app starts. The provider's scope
# mapping must be filtered to this application: a claim built from all of a
# user's groups advertises one app's access inside another app's token.
# OIDC_CLAIMS_SCOPE=roles

# Optional — comma-separated CORS origins. Unset denies every cross-origin caller,
# which is correct for the single-container deployment: the dashboard is same-origin.
# CORS_ALLOWED_ORIGINS is the canonical name; ALLOWED_ORIGINS and DOMAINS still work.
# ALLOWED_ORIGINS=

# Optional — comma-separated hostnames allowed as internal webhook targets for alerts
# (e.g. nook). External https URLs always work; private/loopback/metadata addresses are
# blocked unless the host is listed here.
# WEBHOOK_ALLOWED_HOSTS=

# Optional — set to "collector" to also run the Docker log collector sidecar
# COMPOSE_PROFILES=collector
